# Copy to .env ON THE VM, chmod 0600, never commit.
#
#   openssl rand -hex 32   # PHONE_TOKEN
#   openssl rand -hex 32   # MAC_TOKEN
#
# DIRECT_TOKEN is Milestone 2 only and must NEVER appear here — it belongs on
# the phone and the Mac, not in the relay's environment.

CLICK_BRIDGE_DOMAIN=clicker.example.com
CLICK_BRIDGE_RELEASE=20260812T000000Z
PHONE_TOKEN=replace-with-64-lowercase-hex
MAC_TOKEN=replace-with-a-different-64-lowercase-hex
