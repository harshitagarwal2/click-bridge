# Copy only for local validation. Production uses the mode-0600 file
# /opt/click-bridge/shared/secrets.env outside every immutable release.
CLICK_BRIDGE_DOMAIN=clicker.example.com
CLICK_BRIDGE_RELEASE=20260812T000000Z
PHONE_TOKEN=replace-with-64-lowercase-hex
MAC_TOKEN=replace-with-a-different-64-lowercase-hex
PAIRING_ENABLED=0
PHONE_AUTH_RECORD=/var/lib/click-bridge/auth/phone-auth.json
# Private desktop sessions are durable verifier-only records. The relay applies
# a 500-session limit and 90-day expiry by default; never put session tokens here.
SESSION_RECORD=/var/lib/click-bridge/auth/sessions.json

# Required only when PAIRING_ENABLED=1. This public Apple Team ID is used to
# validate the Universal Link association; it is not a secret.
# APPLE_TEAM_ID=XXXXXXXXXX

# DIRECT_TOKEN belongs only on the phone and Mac after Task 10 begins. It must
# never be added to the relay environment.
