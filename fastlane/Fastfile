require "shellwords"
require "plist"

default_platform(:ios)

private_lane :connect_api_key do
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH"),
    duration: 1_200,
    in_house: false
  )
end

private_lane :verify_archive_version do |options|
  archive_path = options.fetch(:archive_path)
  expected_version = options.fetch(:release_version)
  expected_build = options.fetch(:build_number)
  archive_plist_path = File.join(archive_path, "Info.plist")
  archive_plist = Plist.parse_xml(archive_plist_path)
  application = archive_plist&.fetch("ApplicationProperties", nil)
  UI.user_error!("Archive metadata is missing from #{archive_plist_path}") unless application

  actual_version = application["CFBundleShortVersionString"]&.to_s
  actual_build = application["CFBundleVersion"]&.to_s
  UI.user_error!(
    "Archive version #{actual_version.inspect} does not match #{expected_version.inspect}"
  ) unless actual_version == expected_version
  UI.user_error!(
    "Archive build #{actual_build.inspect} does not match #{expected_build.inspect}"
  ) unless actual_build == expected_build
end

platform :ios do
  desc "Build and upload one signed build to TestFlight without distributing it"
  lane :upload_testflight do |options|
    release_version = options.fetch(:release_version)
    build_number = options.fetch(:build_number)
    bundle_id = ENV.fetch("CLICK_BRIDGE_IOS_BUNDLE_ID", "com.clickbridge.phone")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    output_directory = ENV.fetch("RUNNER_TEMP")
    archive_path = File.join(output_directory, "ClickBridgePhone.xcarchive")
    output_path = File.join(output_directory, "ClickBridgePhone.ipa")

    build_app(
      project: "ios/ClickBridgePhone.xcodeproj",
      scheme: "ClickBridgePhone",
      configuration: "Release",
      clean: true,
      archive_path: archive_path,
      output_directory: output_directory,
      output_name: File.basename(output_path),
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      xcargs: [
        "MARKETING_VERSION=#{Shellwords.escape(release_version)}",
        "CURRENT_PROJECT_VERSION=#{Shellwords.escape(build_number)}",
        "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{Shellwords.escape("Apple Distribution")}",
        "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}"
      ].join(" ")
    )

    verify_archive_version(
      archive_path: archive_path,
      release_version: release_version,
      build_number: build_number
    )

    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: bundle_id,
      ipa: output_path,
      changelog: File.read("fastlane/metadata/en-US/release_notes.txt").strip,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Submit an already processed App Store Connect build for review"
  lane :submit_app_store do |options|
    release_version = options.fetch(:release_version)
    build_number = options.fetch(:build_number)

    deliver(
      api_key: connect_api_key,
      app_identifier: ENV.fetch("CLICK_BRIDGE_IOS_BUNDLE_ID", "com.clickbridge.phone"),
      platform: "ios",
      app_version: release_version,
      build_number: build_number,
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :mac do
  desc "Build and upload one signed macOS build to TestFlight without distributing it"
  lane :upload_testflight do |options|
    release_version = options.fetch(:release_version)
    build_number = options.fetch(:build_number)
    bundle_id = ENV.fetch("CLICK_BRIDGE_MAC_BUNDLE_ID", "com.clickbridge.mac")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    profile_name = ENV.fetch("MAC_PROVISIONING_PROFILE_NAME")
    mac_installer_certificate_name = ENV.fetch("MAC_INSTALLER_CERTIFICATE_NAME")
    output_directory = ENV.fetch("RUNNER_TEMP")
    archive_path = File.join(output_directory, "ClickBridgeMac.xcarchive")

    output_path = build_mac_app(
      project: "mac/ClickBridgeMac.xcodeproj",
      scheme: "ClickBridgeMac",
      configuration: "Release",
      clean: true,
      archive_path: archive_path,
      output_directory: output_directory,
      output_name: "ClickBridgeMac",
      export_method: "app-store",
      skip_package_pkg: false,
      installer_cert_name: mac_installer_certificate_name,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        installerSigningCertificate: mac_installer_certificate_name,
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      xcargs: [
        "MARKETING_VERSION=#{Shellwords.escape(release_version)}",
        "CURRENT_PROJECT_VERSION=#{Shellwords.escape(build_number)}",
        "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{Shellwords.escape("Apple Distribution")}",
        "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}",
        "CODE_SIGN_ENTITLEMENTS=#{Shellwords.escape("ClickBridgeMac/ClickBridgeMac-AppStore.entitlements")}",
        "ENABLE_APP_SANDBOX=YES",
        "ENABLE_HARDENED_RUNTIME=YES"
      ].join(" ")
    )

    verify_archive_version(
      archive_path: archive_path,
      release_version: release_version,
      build_number: build_number
    )

    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: bundle_id,
      app_platform: "osx",
      pkg: output_path,
      changelog: File.read("mac/TestFlight/WhatToTest.en-US.txt").strip,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Submit an already processed Mac App Store build for review"
  lane :submit_app_store do |options|
    release_version = options.fetch(:release_version)
    build_number = options.fetch(:build_number)

    deliver(
      api_key: connect_api_key,
      app_identifier: ENV.fetch("CLICK_BRIDGE_MAC_BUNDLE_ID", "com.clickbridge.mac"),
      platform: "osx",
      app_version: release_version,
      build_number: build_number,
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
